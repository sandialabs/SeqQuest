	ranlib  subs_bla.a

#### Link in source files from source libraries
source_main:
	-for file in ${OBJ_GRD:.o=.f} ; do  \
           if test ! -f $$file ; then       \
              ln -s ${DIR_GRD}/$$file ;     \
           fi ;                             \
         done
	-for file in ${OBJ_SUB:.o=.f} ; do  \
           if test ! -f $$file ; then       \
              ln -s ${DIR_SUB}/$$file ;     \
           fi ;                             \
         done
	-for file in ${OBJ_LIB:.o=.f} ; do  \
           if test ! -f $$file ; then       \
              ln -s ${DIR_LIB}/$$file ;     \
           fi ;                             \
         done

source_lapx:
