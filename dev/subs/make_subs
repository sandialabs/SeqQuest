#### Set compiler for ...
## standard f77
#FC = f77
## gnu
#FC = g77
## pgi/edge
#FC = /opt/pgi/linux86-64/7.2-1/bin/pgf77
## mpi: icc/liberty, nwcc/spirit, tbird, redsky, chama
FC = mpif77

#### Set compiler flags for ...
##  ... general (sun,dec,ibm,...)
# FFLAGS= -O
##  ... dec
# FFLAGS= -O5
##  ... icc/liberty
# FFLAGS= -O2 -tpp7 -xW
##  ... nwcc/spirit, tbird/old/mvapich
# FFLAGS= -O2 -tpp7 -xP
##  ... tbird-mvapiach-0.9.8
# FFLAGS= -O2 -xP
##  ... tbird/opmenmpi-1.1.2
# FFLAGS= -O2 -tpp7 -xP -assume 2underscores
##  ... tbird/opmenmpi-1.2.4 (-tpp7, -assume 2underscores retire) redsky
#FFLAGS= -O2 -xP
## CHAMA
FFLAGS = -O2 -xSSE3 -mcmodel medium -shared-intel

